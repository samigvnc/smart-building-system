# Sunucu Portu
PORT=5000
NODE_ENV=development

# PostgreSQL / TimescaleDB Konfigürasyonu
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=smart_building_db

# RabbitMQ Broker Konfigürasyonu
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_SENSOR_QUEUE=sensor_data_queue
RABBITMQ_CORE_ENGINE_QUEUE=core_engine_queue
RABBITMQ_ENERGY_DECISIONS_QUEUE=energy_decisions_queue

# Akıllı Enerji Stratejisi Parametreleri
BATTERY_MIN_RESERVE_PERCENT=20
BATTERY_MAX_CAPACITY_KWH=100
ELECTRICITY_CHEAP_PRICE_THRESHOLD=0.15

