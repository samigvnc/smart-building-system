# Sunucu Portu
PORT=5000
NODE_ENV=development

# PostgreSQL / TimescaleDB Konfigürasyonu
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=smart_building_db

# RabbitMQ Broker Konfigürasyonu
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_SENSOR_QUEUE=sensor_data_queue
RABBITMQ_CORE_ENGINE_QUEUE=core_engine_queue

# --- Core Engine (Java simülasyon motoru) ile ORTAK varsayılanlar ---
# Kritik binalar (virgülle ayrılmış): LABORATORY, LIBRARY, DORMITORY, CAFETERIA
CRITICAL_BUILDINGS=LABORATORY
# Smart strateji: minimum batarya rezervi (%)
BATTERY_MIN_RESERVE_PERCENT=25
# Smart strateji: bu fiyatın ve üstünün "pahalı" sayıldığı eşik (veri setindeki para birimi/kWh)
SIMULATION_HIGH_PRICE_THRESHOLD=2.5
# Smart strateji: şebeke kesintisinden kaç saat önce bataryayı korumaya başlar
SIMULATION_OUTAGE_LOOKAHEAD_HOURS=3
# Core Engine yanıt bekleme süresi (ms)
CORE_ENGINE_TIMEOUT_MS=15000

# Batarya kapasitesi varsayılanı (simülasyon isteğinde verilmezse)
BATTERY_MAX_CAPACITY_KWH=100

# --- NSRDB (güneş verisi) --- https://developer.nlr.gov/signup/
# Anahtar ve e-posta size aittir; .env git'e eklenmez. Yalnızca `npm run nsrdb:fetch` kullanır.
NSRDB_API_KEY=
NSRDB_EMAIL=
